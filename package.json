{
  "name": "radgraph",
  "private": true,
  "version": "1.0.0",
  "description": "RadGraph DICOM Viewer @Alshaab Hos - v1.0.0",
  "author": "RadGraph Medical",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --win nsis",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.radgraph.medical.workstation",
    "productName": "RadGraph DICOM Viewer @Alshaab Hos",
    "copyright": "Copyright © 2026 RadGraph Medical Platform",
    "asar": true,
    "directories": {
      "output": "dist_installer",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RadGraph DICOM Viewer @Alshaab Hos",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "RadGraph DICOM Viewer @Alshaab Hos"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dcmjs": "^0.30.0",
    "dicom-parser": "^1.8.21",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
